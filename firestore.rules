rules_version = '2';
// Modern F-15E Test Tracker - Firestore security rules.
// Paste this whole file into Firebase console > Firestore Database > Rules, then press Publish.
// Roles live in the document config/team: { owner: "<email>", admins: [emails], testers: [emails] }.
//   owner   - shown as Owner ("" = not set yet). Always in admins. Only the owner hands the role on; any dev can fill it when empty.
//   admins  - the owner plus the devs: full control (check / X, checks, sectors, photos, the team, adding devs).
//   testers - can read everything and write only their own flags (reports/<their uid>), their name and the activity log.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function teamPath() {
      return /databases/$(database)/documents/config/team;
    }
    function hasTeam() {
      return exists(teamPath());
    }
    function team() {
      return get(teamPath()).data;
    }
    function isAdmin() {
      return signedIn() && hasTeam() && email() in team().admins;
    }
    function isMember() {
      return signedIn() && hasTeam() && (email() in team().admins || email() in team().testers);
    }
    function isOwner() {
      return signedIn() && hasTeam() && email() == team().owner;
    }

    match /config/team {
      allow read: if isMember();
      // First claim only: the person creating it becomes the owner and only lead.
      allow create: if signedIn() && !hasTeam()
        && request.resource.data.owner == email()
        && request.resource.data.admins == [email()]
        && request.resource.data.testers == [];
      // The owner and devs manage devs and testers. The owner (when set) always stays in admins.
      // Only the current owner can hand the owner role on; while it is empty ("") any dev can fill it.
      allow update: if isAdmin()
        && request.resource.data.admins is list
        && request.resource.data.testers is list
        && (request.resource.data.owner == "" || request.resource.data.owner in request.resource.data.admins)
        && (request.resource.data.owner == resource.data.owner || isOwner() || resource.data.owner == "");
      allow delete: if false;
    }

    match /config/roadmap {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /config/seeded {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Who did what: anyone on the team adds entries as themselves; nobody edits them; the owner and devs can clear them.
    match /log/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /items/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /reports/{uid} {
      allow read: if isMember();
      allow write: if isAdmin() || (isMember() && request.auth.uid == uid);
    }

    match /people/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    match /photos/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Build history: a dev's Reset saves the round's results here first; the team can look back.
    match /builds/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // "Ask to join": anyone signed in can file their own request; leads read and clear them.
    match /requests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == email();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
  }
}
